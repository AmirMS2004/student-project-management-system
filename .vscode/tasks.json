{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DB: Upgrade (alembic upgrade head)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "args": ["-m", "alembic", "upgrade", "head"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "DB: Seed sample data",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "args": ["seed.py"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Test: Run backend tests (pytest)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "args": ["-m", "pytest"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Run Backend (FastAPI)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv/Scripts/uvicorn.exe",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "run-all" }
    },
    {
      "label": "Run Frontend (Vite)",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "run-all" }
    },
    {
      "label": "Run Backend + Frontend",
      "dependsOn": ["Run Backend (FastAPI)", "Run Frontend (Vite)"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
